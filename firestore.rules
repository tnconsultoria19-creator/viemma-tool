rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() >= 4 && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Genuine staff verification: Non-anonymous verified staff email or staff document
    function isStaff() {
      return isSignedIn() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        (
          request.auth.token.email.matches('(?i)^olisbel@gmail\\.com$') ||
          (request.auth.token.email != null && request.auth.token.email.matches('(?i).*@(viemmatours\\.com|viemma\\.co\\.za)$') && request.auth.token.email_verified == true) ||
          exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // Public share documents are bearer links; enforce revocation and expiry
    // with server time as well as the client-side presentation check.
    function shareLinkIsLive() {
      return resource.data.active == true &&
        (
          !('accessPolicy' in resource.data) ||
          !('expiresAtTimestamp' in resource.data.accessPolicy) ||
          resource.data.accessPolicy.expiresAtTimestamp == null ||
          request.time < resource.data.accessPolicy.expiresAtTimestamp
        );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================================
    // 1. /trips/{tripId} — PRIVATE MASTER ITINERARY
    // Contains net costs, markups, margins, supplier payments,
    // and confidential internal notes.
    // Strictly requires genuine authenticated staff credentials.
    // Anonymous users CANNOT read or write master trips.
    // NEVER publicly readable or listable.
    // ========================================================
    match /trips/{tripId} {
      allow read, write: if isStaff() && isValidId(tripId);
    }

    // Staff and Administrator registries
    match /staff/{uid} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ========================================================
    // 2. /clientShares/{token} — CLIENT-SAFE PROJECTION
    // Publicly accessible ONLY by exact token.
    // Listing the entire collection is strictly forbidden.
    // Writes restricted to authenticated staff publishers.
    // ========================================================
    match /clientShares/{token} {
      allow get: if isValidId(token) && shareLinkIsLive();
      allow list: if false;
      allow write: if isStaff() && isValidId(token);
    }

    // ========================================================
    // 3. /agentShares/{token} — AGENT-SAFE PROJECTION
    // Publicly accessible ONLY by exact token.
    // Listing the entire collection is strictly forbidden.
    // Writes restricted to authenticated staff publishers.
    // ========================================================
    match /agentShares/{token} {
      allow get: if isValidId(token) && shareLinkIsLive();
      allow list: if false;
      allow write: if isStaff() && isValidId(token);
    }

    // ========================================================
    // 4. /opsShares/{token} — OPS-SAFE PROJECTION
    // Publicly accessible ONLY by exact token.
    // Listing the entire collection is strictly forbidden.
    // Writes restricted to authenticated staff publishers.
    // ========================================================
    match /opsShares/{token} {
      allow get: if isValidId(token) && shareLinkIsLive();
      allow list: if false;
      allow write: if isStaff() && isValidId(token);
    }
  }
}
