rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() >= 4 && id.size() <= 128;
    }

    // ========================================================
    // 1. /trips/{tripId} — PRIVATE MASTER ITINERARY
    // Contains net costs, markups, margins, supplier payments,
    // and confidential internal notes.
    // Strictly requires authenticated staff credentials.
    // NEVER publicly readable or listable.
    // ========================================================
    match /trips/{tripId} {
      allow read, write: if request.auth != null && isValidId(tripId);
    }

    // ========================================================
    // 2. /clientShares/{token} — CLIENT-SAFE PROJECTION
    // Publicly accessible ONLY by exact token.
    // Listing the entire collection is strictly forbidden.
    // Writes restricted to authenticated staff publishers.
    // ========================================================
    match /clientShares/{token} {
      allow get: if isValidId(token);
      allow list: if false;
      allow write: if request.auth != null && isValidId(token);
    }

    // ========================================================
    // 3. /agentShares/{token} — AGENT-SAFE PROJECTION
    // Publicly accessible ONLY by exact token.
    // Listing the entire collection is strictly forbidden.
    // Writes restricted to authenticated staff publishers.
    // ========================================================
    match /agentShares/{token} {
      allow get: if isValidId(token);
      allow list: if false;
      allow write: if request.auth != null && isValidId(token);
    }

    // ========================================================
    // 4. /opsShares/{token} — OPS-SAFE PROJECTION
    // Publicly accessible ONLY by exact token.
    // Listing the entire collection is strictly forbidden.
    // Writes restricted to authenticated staff publishers.
    // ========================================================
    match /opsShares/{token} {
      allow get: if isValidId(token);
      allow list: if false;
      allow write: if request.auth != null && isValidId(token);
    }
  }
}
