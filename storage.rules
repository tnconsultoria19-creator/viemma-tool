rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Supporting files are stored below the Firebase Auth owner UID.
    // The client never supplies this path segment; upload code reads it from auth.currentUser.
    match /attachments/{ownerUid}/{bookingRef}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == ownerUid;
      allow create, update: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/jpg',
          'image/png',
          'image/webp'
        ];
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }
  }
}
