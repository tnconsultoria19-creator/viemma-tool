rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isViemmaStaff() {
      return request.auth != null &&
        request.auth.token.email != null &&
        (
          request.auth.token.email.matches('(?i)^olisbel@gmail\\.com$') ||
          request.auth.token.email.matches('(?i).*@(viemmatours\\.com|viemma\\.co\\.za)$')
        );
    }

    // Reusable presentation images. Owners can manage their uploads; verified
    // Viemma staff can read and curate shared assets across the workspace.
    match /presentation-media/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == userId || isViemmaStaff());
    }

    // Existing secure document and media attachments.
    match /attachments/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email.matches('(?i)^olisbel@gmail\\.com$') ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i).*@(viemmatours\\.com|viemma\\.co\\.za)$'))
      );
    }
  }
}
