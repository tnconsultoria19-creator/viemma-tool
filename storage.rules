        (request.auth.token.email != null && request.auth.token.email.matches('(?i).*@(viemmatours\\.com|viemma\\.co\\.za)
    match /attachments/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email.matches('(?i)^olisbel@gmail\\.com$') ||
